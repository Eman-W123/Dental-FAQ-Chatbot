# Copy this file to ".env" and fill in your real values.

# Your Gemini API key (get one free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model used for replies.
GEMINI_MODEL=gemini-flash-latest

# Optional: secret used to sign the browser session cookie.
# Set to any long random string in production.
FLASK_SECRET_KEY=change-me-to-a-random-string
